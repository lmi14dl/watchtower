+
+
+def _chunks(text, limit):
+    """Split text into pieces <= limit characters, preferring line boundaries."""
+    out, cur = [], ""
+    for line in text.splitlines(True):
+        while len(line) > limit:
+            if cur:
+                out.append(cur)
+                cur = ""
+            out.append(line[:limit])
+            line = line[limit:]
+        if cur and len(cur) + len(line) > limit:
+            out.append(cur)
+            cur = ""
+        cur += line
+    if cur:
+        out.append(cur)
+    return out
+
 
