# Watchtower - Docker Environment Configuration
# Copy this file to .env and fill in your values

# Discord webhook URL (REQUIRED for notifications)
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/YOUR/WEBHOOK

# Paths inside the container (mapped via docker-compose volumes)
# These are the in-container paths - mount your host files via volumes
RESOLVERS_PATH=/app/config/resolvers/resolvers.txt
DNS_BRUTE_WORDLIST=/app/config/wordlists/words-merged.txt
GAU_CONFIG=/app/config/gau-config/.gau.toml

# MongoDB connection (docker-compose sets MONGO_HOST=mongo)
MONGO_HOST=mongo
MONGO_PORT=27017
MONGO_DB=watchtower

# API Authentication (HTTP Basic Auth)
# Change these to strong passwords before deploying
WATCHTOWER_API_USER=admin
WATCHTOWER_API_PASS=changeme
