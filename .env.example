# Watchtower - Docker Environment Configuration
# Copy this file to .env and fill in your values

# Discord webhook URL (optional, for notifications)
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/YOUR/WEBHOOK

# Telegram bot credentials (optional, for notifications)
# Get your bot token from @BotFather and chat_id from @userinfobot
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here

# Paths inside the container (mapped via docker-compose volumes)
# These are the in-container paths - mount your host files via volumes
RESOLVERS_PATH=/app/config/resolvers/resolvers.txt
DNS_BRUTE_WORDLIST=/app/config/wordlists/words-merged.txt
GAU_CONFIG=/app/config/gau-config/.gau.toml

# MongoDB connection (docker-compose sets MONGO_HOST=mongo)
MONGO_HOST=mongo
MONGO_PORT=27017
MONGO_DB=watchtower

# API Authentication (HTTP Basic Auth)
# Change these to strong passwords before deploying
WATCHTOWER_API_USER=admin
WATCHTOWER_API_PASS=changeme

# ---------------------------------------------------------------------------
# Resource tuning (all optional, defaults are light)
# ---------------------------------------------------------------------------
# nice level for every external tool (0 disables), default timeout in seconds
WATCH_NICE=19
WATCH_CMD_TIMEOUT=7200
# Incremental runs: only (re)process items older than N hours
RESOLVE_STALE_HOURS=24
HTTP_STALE_HOURS=24
# subfinder: set SUBFINDER_ALL=1 to use every source (heavier)
SUBFINDER_ALL=0
SUBFINDER_RATE_LIMIT=30
# gau / waybackurls: cap on URLs processed per domain
ENUM_MAX_URLS=500000
# dnsx
DNSX_THREADS=20
DNSX_RATE_LIMIT=50
# httpx: tech-detect / favicon are CPU/request heavy, opt in with 1
HTTPX_PORTS=80,443
HTTPX_THREADS=10
HTTPX_RATE_LIMIT=10
HTTPX_RETRIES=1
HTTPX_TIMEOUT=7
HTTPX_TECH=0
HTTPX_FAVICON=0
# nuclei: scan only new URLs (rescan after N days), capped per run
NUCLEI_RESCAN_DAYS=7
NUCLEI_MAX_URLS_PER_RUN=2000
# NUCLEI_TEMPLATES=/app/nuclei-templates/http/exposed-panels
# Notifications are batched; max messages per process, 1 = disable DB-level alerts
NOTIFY_MAX_PER_RUN=200
# WATCH_NO_NOTIFY=1
